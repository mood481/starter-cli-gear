{
    "name": "@mood481/starter-cli-go",
    "version": "0.1.0",
    "private": false,
    "description": "Reusable starter for CLI Starter.",
    "type": "module",
    "bin": "./bin/starter-render.mjs",
    "files": [
        "starter.yaml",
        "bin/**",
        "README.md",
        "template/**",
        "modes/**",
        "variants/**",
        "modes/standalone/overlay/**",
        "modes/module/overlay/**"
    ],
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.20.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "starter:validate": "starter-validate --type starter starter.yaml",
        "validate": "starter-validate --type starter starter.yaml"
    },
    "dependencies": {
        "@mood481/starter-renderer": "^0.5.1"
    },
    "devDependencies": {
        "@mood481/starter-contracts": "^0.5.1",
        "@mood481/starter-validator": "^0.5.1",
        "@mood481/starter-publish-tools": "^0.1.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
